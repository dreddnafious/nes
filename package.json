{
  "name": "browser-console",
  "private": true,
  "version": "0.1.0",
  "description": "A NES emulator in TypeScript: a pure core run headless under Node, and a browser front end.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": ".venv/bin/python -m pytest cases tests -p no:cacheprovider -q",
    "smoke": ".venv/bin/python -B smoke/smoke.py"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
